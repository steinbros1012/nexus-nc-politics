generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          Role      @default(EDITOR)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]
}

enum Role {
  SUPER_ADMIN
  EDITOR
  CONTRIBUTOR
  ANALYST
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model NewsSource {
  id                  String         @id @default(cuid())
  name                String
  slug                String         @unique
  website             String
  rssUrl              String?
  logoUrl             String?
  description         String?
  geographicCoverage  String[]
  categories          String[]
  active              Boolean        @default(true)
  lastSuccessfulFetch DateTime?
  lastAttemptedFetch  DateTime?
  articleCount        Int            @default(0)
  errorMessage        String?
  hasError            Boolean        @default(false)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  articles            Article[]
  ingestionLogs       IngestionLog[]
}

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  parentId    String?
  parent      Category?  @relation("SubCategories", fields: [parentId], references: [id])
  children    Category[] @relation("SubCategories")
  color       String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  articles    Article[]
}

model Region {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  markets     Market[]
  articles    Article[]
}

model Market {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  type      MarketType @default(CITY)
  state     String     @default("NC")
  regionId  String?
  region    Region?    @relation(fields: [regionId], references: [id])
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  articles  Article[]
}

enum MarketType {
  CITY
  COUNTY
  METRO
}

model Article {
  id            String   @id @default(cuid())
  title         String
  slug          String   @unique
  summary       String?  @db.Text
  aiSummary     String?  @db.Text
  originalUrl   String   @unique
  imageUrl      String?
  author        String?
  publishedAt   DateTime
  fetchedAt     DateTime @default(now())
  sourceId      String
  source        NewsSource @relation(fields: [sourceId], references: [id])
  categoryId    String?
  category      Category?  @relation(fields: [categoryId], references: [id])
  regionId      String?
  region        Region?    @relation(fields: [regionId], references: [id])
  marketId      String?
  market        Market?    @relation(fields: [marketId], references: [id])
  tags          String[]
  isBreaking    Boolean  @default(false)
  isFeatured    Boolean  @default(false)
  isEditorsPick Boolean  @default(false)
  isHidden      Boolean  @default(false)
  viewCount     Int      @default(0)
  clickCount    Int      @default(0)
  aiClassified  Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  views         ArticleView[]
  clicks        ExternalClick[]
}

model ArticleView {
  id        String   @id @default(cuid())
  articleId String
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())
}

model ExternalClick {
  id        String   @id @default(cuid())
  articleId String
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())
}

model OpinionSubmission {
  id              String        @id @default(cuid())
  type            OpinionType
  status          OpinionStatus @default(SUBMITTED)
  firstName       String
  lastName        String
  email           String
  phone           String?
  city            String?
  state           String        @default("NC")
  organization    String?
  titleRole       String?
  headline        String
  body            String        @db.Text
  authorBio       String?       @db.Text
  supportingLinks String[]
  headshot        String?
  slug            String?       @unique
  publishedAt     DateTime?
  adminNotes      String?       @db.Text
  confirmOriginal Boolean       @default(false)
  confirmAccuracy Boolean       @default(false)
  confirmEditing  Boolean       @default(false)
  tags            String[]
  viewCount       Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

enum OpinionType {
  EDITORIAL
  LETTER
}

enum OpinionStatus {
  SUBMITTED
  UNDER_REVIEW
  CHANGES_REQUESTED
  APPROVED
  PUBLISHED
  REJECTED
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model IngestionLog {
  id           String     @id @default(cuid())
  sourceId     String
  source       NewsSource @relation(fields: [sourceId], references: [id])
  status       String
  message      String?
  articlesNew  Int        @default(0)
  articlesDupe Int        @default(0)
  articlesErr  Int        @default(0)
  duration     Int?
  createdAt    DateTime   @default(now())
}

model SiteConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}
